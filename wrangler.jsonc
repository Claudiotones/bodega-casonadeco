{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "bodega-casonadeco",

  "main": "src/worker.js",

  "compatibility_date": "2026-08-17",

  "keep_vars": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bodega-casonadeco-db",
      "database_id": "a6d9ca44-620a-4155-b8cd-eee59b7b0b14"
    }
  ],

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
